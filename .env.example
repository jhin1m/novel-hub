# Copy thành `.env` ở gốc repo rồi điền giá trị. Không commit `.env`.
# Phải điền MEILI_MASTER_KEY trước khi chạy `pnpm infra:up`, nếu không compose báo lỗi.
# URL viết literal: Node (`process.loadEnvFile`) không nội suy `${VAR}`, nên các URL
# bên dưới phải tự khớp với POSTGRES_* và cổng *_PORT.

# ---------------------------------------------------------------- Runtime
# development | test | production. Không có mặc định: thiếu thì app báo lỗi.
NODE_ENV=development
# URL gốc của web (dùng để dựng link tuyệt đối).
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- Postgres
# Docker Compose dùng để tạo user và DB. Chỉ áp dụng khi volume khởi tạo lần đầu;
# đổi sau đó không có tác dụng (xem docker/postgres/init/README.md).
POSTGRES_USER=novel_hub
POSTGRES_PASSWORD=novel_hub_dev
POSTGRES_DB=novel_hub
# Cổng trên host (chỉ bind 127.0.0.1). Đổi khi máy đã có Postgres khác ở 5432.
POSTGRES_PORT=5432
# Chuỗi kết nối của app, phải khớp POSTGRES_* và POSTGRES_PORT.
DATABASE_URL=postgres://novel_hub:novel_hub_dev@localhost:5432/novel_hub
# DB cho test integration/e2e; tên phải kết thúc bằng `_test` (init script tạo sẵn).
TEST_DATABASE_URL=postgres://novel_hub:novel_hub_dev@localhost:5432/novel_hub_test

# ---------------------------------------------------------------- Redis
# Cổng trên host (chỉ bind 127.0.0.1). Đổi khi máy đã có Redis khác ở 6379.
REDIS_PORT=6379
# Cache, counter, xếp hạng, hàng đợi BullMQ. Phải khớp REDIS_PORT.
REDIS_URL=redis://localhost:6379/0
# Test integration/e2e dùng DB index riêng (/1) để không đụng dữ liệu dev.
TEST_REDIS_URL=redis://localhost:6379/1

# ---------------------------------------------------------------- Queue
# Tiền tố key của BullMQ trong Redis.
QUEUE_PREFIX=novelhub

# ---------------------------------------------------------------- Meilisearch (dùng từ Giai đoạn 1)
# Khoá master, tối thiểu 16 byte; bắt buộc cả ở dev. Sinh bằng: openssl rand -base64 24
MEILI_MASTER_KEY=
# Cổng trên host (chỉ bind 127.0.0.1).
MEILI_PORT=7700
# URL app gọi tới Meilisearch, phải khớp MEILI_PORT.
MEILI_URL=http://localhost:7700
# development | production. Production bắt buộc đặt production.
MEILI_ENV=development

# ---------------------------------------------------------------- S3 / MinIO (dùng từ Giai đoạn 1)
# Server MinIO tự host có sẵn, dev và production dùng chung server.
# CẢNH BÁO: dev phải dùng bucket riêng, không bao giờ trỏ vào bucket production.
# Endpoint API S3 của MinIO, ví dụ https://s3.example.com
S3_ENDPOINT=
# Region khai báo cho SDK (MinIO mặc định us-east-1).
S3_REGION=us-east-1
# Tên bucket chứa bìa truyện và avatar.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL công khai để hiển thị ảnh (CDN hoặc endpoint public của bucket).
S3_PUBLIC_URL=
# MinIO cần path-style (https://host/bucket/key).
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------- Cloudflare purge (chỉ worker)
# Purge cache HTML công khai khi nội dung đổi. Production bắt buộc đủ cả hai (thiếu thì worker
# không khởi động); dev để trống thì purge là no-op. Token chỉ cần quyền Zone → Cache Purge.
# Xem docs/deployment-cloudflare.md.
CF_ZONE_ID=
CF_API_TOKEN=

# ---------------------------------------------------------------- Better Auth (dùng từ phase 5)
# Tối thiểu 32 ký tự. Sinh bằng: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL gốc mà Better Auth dựng callback, thường bằng APP_URL.
BETTER_AUTH_URL=http://localhost:3000
# OAuth Google. Để trống cả hai thì tắt đăng nhập Google.
# Callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- SMTP (dùng từ phase 5)
# Dev: để trống SMTP_HOST thì link xác thực/đặt lại mật khẩu được in ra log.
# Production: bắt buộc đủ thông tin SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Địa chỉ người gửi, ví dụ "Novel Hub <no-reply@example.com>"
SMTP_FROM=

# ---------------------------------------------------------------- Seed (dùng từ phase 5, chỉ dev)
# Mật khẩu cho các tài khoản mẫu do `pnpm db:seed` tạo.
SEED_USER_PASSWORD=
