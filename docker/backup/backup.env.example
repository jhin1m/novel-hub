# Host config for pg-backup.sh and restore-test.sh (not the app .env).
# Copy to /etc/novel-hub/backup.env, chmod 600, owner root. Never commit it.
# Both scripts read it from BACKUP_ENV_FILE (default /etc/novel-hub/backup.env);
# values in this file override the same variables set in the environment.

# Compose file of the running stack (service "postgres").
# Default: docker-compose.yml at the repo root next to docker/backup/.
COMPOSE_FILE=/opt/novel-hub/docker-compose.yml

# Local dump folder, outside the Postgres volume. Created with mode 700.
BACKUP_DIR=/var/backups/novel-hub/postgres

# Number of local dumps to keep (newest first). `pg-backup.sh --keep N`
# overrides it for one run.
BACKUP_KEEP=14

# A new dump smaller than this fraction of the largest kept dump prunes
# nothing and fails the run (healthcheck /fail) while still uploading, every
# night until a run with BACKUP_ACCEPT_SHRINK=1 on the command line (never
# here) accepts it. 0 turns the check off.
# BACKUP_MIN_RATIO=0.5

# restore-test.sh --remote fails when the newest offsite dump is older than
# this many hours.
# MAX_AGE_H=36

# rclone remote root; dumps go to <remote>/daily/. Use the crypt remote at the
# bucket root so R2 keys start with "daily/" and match the bucket lock prefix.
RCLONE_REMOTE=r2-backup-crypt:

# rclone config holding the R2 credentials and the crypt passwords (chmod 600).
RCLONE_CONFIG=/etc/novel-hub/rclone.conf

# healthchecks.io ping URL; empty disables pings. The script calls the URL on
# success and <URL>/fail on any failure.
HEALTHCHECK_URL=
