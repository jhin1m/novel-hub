# Config for pull-offsite-backup.sh, on the backup machine (not the VPS).
# Copy to ~/.config/novel-hub/pull.env and chmod 600. Never commit it.
# The script reads it from PULL_ENV_FILE (default that path); values here
# override the same variables set in the environment.

# User and host of the VPS on Tailscale; the trailing colon is required. The
# user's forced command (rrsync -ro) treats the dump folder as the root.
PULL_SOURCE=nhbackup@vps-tailscale-name:

# Where pulled dumps live. Created with mode 700; keep it outside any folder
# that is synced to other devices or the cloud.
PULL_DEST=/srv/backups/novel-hub

# Private key whose public half is in the VPS user's authorized_keys.
PULL_SSH_KEY=/home/you/.ssh/novel-hub-pull

# Dumps kept (newest first).
PULL_KEEP=30

# Most new dumps accepted per run (a run normally brings 1, the default). More
# means the source is serving something odd, or a run was skipped: the run fails
# and nothing is stored; raise it for one run after inspecting the source.
# An empty destination may take up to PULL_KEEP once.
# PULL_MAX_NEW=1

# Months of monthly copies kept in PULL_DEST/monthly (the first dump pulled in
# each month). Never touched by the daily PULL_KEEP pruning.
# PULL_MONTHLY_KEEP=12   # 0 = no monthly copies (production uses 0 with PULL_KEEP=7)

# A newest dump smaller than this fraction of the largest held dump prunes
# nothing and fails the run until PULL_ACCEPT_SHRINK=1 is given on the command
# line (never here). 0 turns the check off.
# PULL_MIN_RATIO=0.5

# Fail when the newest dump is older than this many hours.
# MAX_AGE_H=36

# healthchecks.io ping URL; empty disables pings. Called on success, and
# <URL>/fail on any failure.
HEALTHCHECK_URL=
